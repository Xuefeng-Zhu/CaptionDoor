# Local demo; no cloud credentials required. Copy to .env (never commit .env).
NODE_ENV=development
AUTH_MODE=demo
RING_MODE=demo
TRANSCRIBE_MODE=fixture
APP_ORIGIN=http://127.0.0.1:3410
WS_PUBLIC_URL=ws://127.0.0.1:3411/ws
WORKER_PORT=3411
DYNAMODB_ENDPOINT=http://127.0.0.1:8410
AWS_REGION=us-east-1
CAPTIONDOOR_CONFIG_TABLE=CaptionDoorConfig
CAPTIONDOOR_VISITS_TABLE=CaptionDoorVisits
CAPTIONDOOR_RUNTIME_TABLE=CaptionDoorRuntime
# Runtime credential values are intentionally absent. Do not prefix secrets NEXT_PUBLIC_.
# Cloud: NODE_ENV=production AUTH_MODE=oidc RING_MODE=live TRANSCRIBE_MODE=aws
# Unset DYNAMODB_ENDPOINT for AWS; configure an authorized IAM role, not embedded keys.
# COGNITO_ISSUER=https://cognito-idp.REGION.amazonaws.com/USER_POOL_ID
# COGNITO_CLIENT_ID=REGISTERED_COGNITO_CLIENT_ID
# COGNITO_CLIENT_SECRET=SERVER_SIDE_SECRET_IF_CONFIDENTIAL_CLIENT
# Cognito registered callback: https://YOUR_DOMAIN/api/auth/callback
# RING_CLIENT_ID=APPROVED_PARTNER_ID
# RING_CLIENT_SECRET=SERVER_SIDE_PARTNER_SECRET
# RING_WEBHOOK_SECRET=PARTNER_HMAC_KEY
# RING_REDIRECT_URI=https://YOUR_DOMAIN/api/ring/callback
# RING_PLAYGROUND_TOKEN=SHORT_LIVED_OFFICIAL_TOKEN_ONLY_WHEN_RING_MODE_PLAYGROUND
# CREDENTIAL_ENCRYPTION_MODE=kms
# RING_KMS_KEY_ID=DEPLOYED_CREDENTIAL_ENCRYPTION_KEY_ARN
# Local external-adapter tests only: CREDENTIAL_ENCRYPTION_MODE=development
# DEV_CREDENTIAL_KEY=32_BYTE_BASE64_KEY_GENERATED_LOCALLY_NOT_IN_REPOSITORY
# SQS_QUEUE_URL=DEPLOYED_SQS_QUEUE_URL
# VAPID_PUBLIC_KEY=GENERATED_PUBLIC_KEY
# VAPID_PRIVATE_KEY=SERVER_SIDE_PRIVATE_KEY
# VAPID_SUBJECT=mailto:YOUR_SUPPORT_ADDRESS
# Optional local HTTPS profile uses Caddy's private CA; trust is not installed automatically.
# APP_ORIGIN=https://localhost:3443
# WS_PUBLIC_URL=wss://localhost:3443/ws
# CAPTIONDOOR_TLS_ADDRESS=https://localhost:3443
